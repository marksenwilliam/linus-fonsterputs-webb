---
/**
 * Strukturerad data: LocalBusiness. Samma block ligger på alla indexerbara
 * sidor med samma @id, så att Google ser en enda verksamhet och inte en per
 * sida. Det står bara här – ändra en uppgift (e-post, telefon, priser,
 * öppettider) och den ändras överallt.
 *
 * Adressen anges bara på ort- och länsnivå: Linus jobbar hos kunden, inte på
 * en besöksadress som kunder söker upp, och en påhittad gatuadress i
 * strukturerad data är värre än ingen alls (fel uppgift till Google). Lägg
 * till streetAddress, postalCode och geo här bara om en riktig, publik
 * besöksadress ska anges.
 *
 * Lägg inte in aggregateRating eller review: omdömen ett företag publicerar
 * om sig självt räknas som self-serving och ger inga utökade sökresultat för
 * LocalBusiness. Se punkt 7 i ATT-GORA-INNAN-LANSERING.md.
 */
import { SITE } from '../config';

const foretag = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE}/#business`,
  name: 'Linus Fönsterputs',
  legalName: 'Linus Fönsterputs',
  description: 'Fönsterputs och kontorsputs i Uppsala med omnejd. Enmansfirma – alltid samma person på plats.',
  url: `${SITE}/`,
  logo: `${SITE}/bilder/logga-mork.png`,
  image: `${SITE}/og-bild.jpg`,
  telephone: '+46762171833',
  email: 'kontakt@linusfonsterputs.se',
  priceRange: '$$',
  currenciesAccepted: 'SEK',
  paymentAccepted: 'Faktura',
  taxID: '031221-5551',
  vatID: 'SE031221555101',
  address: { '@type': 'PostalAddress', addressLocality: 'Uppsala', addressRegion: 'Uppsala län', addressCountry: 'SE' },
  areaServed: [
    { '@type': 'City', name: 'Uppsala' },
    { '@type': 'City', name: 'Knivsta' },
    { '@type': 'City', name: 'Storvreta' },
    { '@type': 'City', name: 'Enköping' },
    { '@type': 'City', name: 'Östhammar' },
    { '@type': 'City', name: 'Heby' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '17:00',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '14:00' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Tjänster',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Fönsterputs' },
        price: '1500',
        priceCurrency: 'SEK',
        description: 'Fast pris per hus inkl. RUT-avdrag (3 000 kr ex. RUT), oavsett antal fönster.',
      },
      {
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: 'Kontorsputs' },
        price: '515',
        priceCurrency: 'SEK',
        description: 'Från 515 kr per tillfälle exklusive moms. Priset följer lokalens storlek.',
      },
    ],
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(foretag, null, 2)} />
